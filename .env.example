# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- AI ---
# Gemini: powers blueprint generation, site audits, proposal/contract drafting,
# the URL scraper, and multimodal dossier extraction.
GEMINI_API_KEY=

# --- App ---
# Public URL this instance is served from. Used for OAuth callbacks and self-links.
APP_URL=http://localhost:3000

# --- Auth (server-side admin gate) ---
# Comma-separated allowlist of emails permitted to call /api routes.
# Optional: defaults to contact.txsons@gmail.com,morganmv145@gmail.com.
# This is the REAL boundary — the browser-side list in Settings is only cosmetic.
ADMIN_EMAILS=

# --- Data ---
# Supabase: leads, projects, invoices, client_intakes + admin session verification.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service-role key. SERVER ONLY — it BYPASSES row level security entirely.
# Required for public write paths that have no user session:
#   /api/lead          form submissions from deployed client sites
#   intake portal      client asset/content submissions
# Find it in Supabase: Project Settings -> API -> service_role (NOT anon).
# NEVER give this a VITE_ prefix — Vite inlines VITE_* vars into the browser
# bundle, which would hand every visitor full read/write on your database.
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token from Supabase > Account > Access Tokens.
# Powers both the Supabase MCP server (.mcp.json) and `npm run migrate`.
# Account-wide: it can reach every Supabase project you own, so keep it out of
# tracked files. Not needed to run the app - only to change the schema.
SUPABASE_ACCESS_TOKEN=

# --- Deployment ---
# Cloudflare Pages: 1-click site deploys and custom domain provisioning.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Billing ---
# Stripe: invoice generation.
STRIPE_SECRET_KEY=

# --- Discovery ---
# Google Maps Platform: prospect/business discovery in the Prospects view.
VITE_GOOGLE_MAPS_PLATFORM_KEY=

# --- Model routing ---
# OpenRouter: one key for DeepSeek, Llama, Qwen and others behind a single
# OpenAI-shaped endpoint. Get it at openrouter.ai/keys.
# Only needed if you route a task to the `openrouter` provider (see below).
OPENROUTER_API_KEY=

# Per-task model overrides. Format: provider:model, where provider is `gemini`
# or `openrouter`. Omit to use the default in lib/models.ts.
#
#   MODEL_ASSISTANT=openrouter:deepseek/deepseek-chat
#   MODEL_SCRAPE_EXTRACT=openrouter:deepseek/deepseek-chat
#   MODEL_STUDIO_EDIT=openrouter:deepseek/deepseek-chat
#
# extract-dossier is multimodal and always runs on Gemini regardless of config —
# a text model would silently ignore the photos and invent an answer.

# --- Optional ---
# GitHub API access, used by repo automation routes.
GITHUB_ACCESS_TOKEN=

# Client sites on their own domain rather than a *.pages.dev subdomain.
# Comma-separated origins, no trailing slash. Needed so their lead forms and
# admin pages can reach this API from the browser; pages.dev subdomains and
# localhost are allowed without configuration.
#   CLIENT_SITE_ORIGINS=https://opalescentcolorstudio.com,https://www.opalescentcolorstudio.com
CLIENT_SITE_ORIGINS=

# --- Obsidian vault (optional) ---
# Two settings: where the vault is, and the key to read it.
#
# WHERE. Not a folder on your machine — the repo's address on GitHub, the tail of
# https://github.com/<owner>/<repo>. A PRIVATE repo holding your notes, synced
# from every device by the Obsidian Git plugin. The server reads it over the API
# and never touches your local copy, which is why this works from a phone too.
#
#   OBSIDIAN_VAULT_REPO=Texas-Sons/vault
OBSIDIAN_VAULT_REPO=
# Defaults to main.
OBSIDIAN_VAULT_BRANCH=

# THE KEY. A fine-grained token with Contents: Read-only on that one repository,
# and nothing else. Kept separate from GITHUB_ACCESS_TOKEN because the two jobs
# want different powers — repo automation writes, this only reads — and a
# read-only token scoped to one repo is a much smaller loss if it leaks.
# Falls back to GITHUB_ACCESS_TOKEN when unset.
VAULT_GITHUB_TOKEN=

# When both are set, the business assistant retrieves the few notes relevant to
# each question and adds them to its context. Unset means it simply knows less;
# an unreachable vault degrades to no notes rather than a failed reply.
