{
  "name": "texas-sons-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && eslint .",
    "test": "tsx scripts/smoke-client.ts && tsx scripts/smoke-security.ts && tsx scripts/smoke-mapping.ts && tsx scripts/smoke-insights.ts && tsx scripts/smoke-health.ts && tsx scripts/smoke-media.ts && tsx scripts/smoke-vault.ts && tsx scripts/smoke-clients.ts",
    "verify": "npm run lint && npm test && npm run build",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "logo:transparent": "tsx scripts/logo-transparent.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@noble/hashes": "^2.3.0",
    "@octokit/rest": "^22.0.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vis.gl/react-google-maps": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^8.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^13.1.0",
    "helmet": "^8.3.0",
    "jimp": "^1.6.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "puppeteer": "^25.9.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.2.3"
  }
}
